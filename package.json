{
    "name": "@mesonsystems/chessboard",
    "version": "1.0.1",
    "description": "An elegant, highly-customizable chessboard.",
    "author": "Mayaz Rakib",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./dist/index.js",
        "./dist/style.css"
    ],
    "files": [
        "dist",
        "asset",
        "README.md",
        "LICENSE"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./style.css": "./dist/style.css",
        "./pieces.svg": "./asset/pieces/pieces.svg",
        "./pieces/cburnett/*.svg": "./asset/pieces/cburnett/*.svg",
        "./core": {
            "types": "./dist/core.d.ts",
            "default": "./dist/core.js"
        },
        "./replay": {
            "types": "./dist/replay.d.ts",
            "default": "./dist/replay.js"
        },
        "./audio/*.mp3": "./asset/audio/*.mp3"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "check": "tsc --noEmit && tsc --project tsconfig.demo.json",
        "dev": "vite --host 127.0.0.1 --port 31415 --strictPort",
        "test": "npm run build && node --test test/unit/*_test.js test/integration/*_test.js",
        "test:unit": "npm run build && node --test test/unit/*_test.js",
        "test:integration": "npm run build && node --test test/integration/*_test.js",
        "test:browser": "playwright test",
        "test:package": "npm run build && node scripts/package_smoke_test.js",
        "test:all": "npm test && npm run test:browser",
        "test:release": "npm run check && npm test && npm run test:browser && npm run test:package",
        "prepack": "npm run check && npm test",
        "coverage": "npm run build && node scripts/coverage.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "chess.js": "^1.4.0"
    },
    "devDependencies": {
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "happy-dom": "^20.14.5",
        "lucide-react": "^1.50.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "shadcn": "^4.21.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.2"
    },
    "keywords": [
        "chess",
        "chessboard",
        "web-component",
        "typescript",
        "board"
    ]
}
